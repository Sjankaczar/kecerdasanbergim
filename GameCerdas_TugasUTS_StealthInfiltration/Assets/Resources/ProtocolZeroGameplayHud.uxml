<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/ProtocolZeroGameplayHud.uss?fileID=7433441132597879392&amp;guid=58bab699012a9024f8710d7a8e3c476a&amp;type=3#ProtocolZeroGameplayHud"/>
    <ui:VisualElement name="gameplay-hud-root" class="gameplay-hud-root">
        <ui:VisualElement name="objective-card" class="hud-objective-card" style="height: 184px; width: 611px;">
            <ui:VisualElement class="hud-objective-accent"/>
            <ui:Label text="MISSION OBJECTIVE" class="hud-eyebrow" style="width: 503px; height: 64px; font-size: 32px; top: 16px; left: 26px;"/>
            <ui:Label name="objective-number" text="01 / 02" class="hud-objective-number" style="width: 100px; height: 44px; left: 495px; font-size: 24px; top: 14px; right: 46px;"/>
            <ui:Label name="objective-description" text="Find and collect the experimental potion." class="hud-objective-description" style="top: 115px; left: 26px; width: 579px; font-size: 25px; height: 40px;"/>
            <ui:Label name="objective-title" text="Retrieve the Experiment" class="hud-objective-title" style="width: 528px; top: 66px; left: 27px; height: 58px; font-size: 32px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="threat-card" class="hud-threat-card" style="height: 125px;">
            <ui:VisualElement name="detection-accent" class="hud-threat-accent"/>
            <ui:Label text="SECURITY STATUS" class="hud-threat-label" style="height: 52px; width: 483px; font-size: 28px; top: 12px; left: 23px;"/>
            <ui:Label name="detection-status" text="UNDETECTED" class="hud-threat-status" style="top: 52px; left: 20px; font-size: 28px; height: 66px; width: 324px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="interaction-prompt" class="hud-interaction-prompt" style="height: 82px; bottom: 115px; width: 445px; left: 1002px;">
            <ui:Label name="interaction-copy" text="COLLECT EXPERIMENT" class="hud-interaction-copy" style="right: 36px; top: 8px; left: 106px; height: 61px; font-size: 25px;"/>
            <ui:Label name="interaction-key" text="E" class="hud-interaction-key" style="height: 54px; width: 53px; top: 14px; left: 21px; font-size: 47px;"/>
        </ui:VisualElement>
        <ui:Label name="controls-hint" text="WASD MOVE   |   SHIFT SPRINT   |   E COLLECT   |   ESC PAUSE" class="hud-controls-hint" style="right: 943px; bottom: 30px; left: 956px; height: 64px; font-size: 21px;"/>
        <ui:VisualElement name="notification-panel" class="hud-notification">
            <ui:Label name="notification-label" class="hud-notification-copy"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
