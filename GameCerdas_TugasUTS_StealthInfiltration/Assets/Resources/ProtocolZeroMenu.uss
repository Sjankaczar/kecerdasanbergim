.protocol-root {
    width: 100%;
    height: 100%;
    color: rgb(231, 243, 249);
    font-size: 16px;
}

.menu-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
    background-color: rgb(3, 10, 16);
}

.menu-background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.left-shade {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 54%;
    background-color: rgba(2, 12, 18, 0.32);
}

.screen-frame {
    position: absolute;
    left: 1.15%;
    right: 1.15%;
    top: 2.1%;
    bottom: 2.1%;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(126, 205, 231, 0.55);
    border-right-color: rgba(126, 205, 231, 0.4);
    border-bottom-color: rgba(126, 205, 231, 0.55);
    border-left-color: rgba(126, 205, 231, 0.4);
}

.top-header {
    position: absolute;
    left: 2.7%;
    right: 2.7%;
    top: 4.2%;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.facility-identity {
    flex-direction: row;
    align-items: center;
}

.facility-emblem {
    color: rgb(157, 205, 222);
    font-size: 40px;
    margin-right: 24px;
}

.micro-label {
    color: rgb(158, 181, 194);
    font-size: 13px;
    letter-spacing: 3px;
}

.clearance-block {
    align-items: flex-end;
}

.clearance-block .micro-label {
    font-size: 10px;
    letter-spacing: 2px;
    -unity-text-align: upper-right;
}

.secret-label {
    color: rgb(255, 66, 75);
    font-size: 12px;
    letter-spacing: 3px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(255, 66, 75);
    border-right-color: rgb(255, 66, 75);
    border-bottom-color: rgb(255, 66, 75);
    border-left-color: rgb(255, 66, 75);
    padding-top: 4px;
    padding-right: 9px;
    padding-bottom: 4px;
    padding-left: 9px;
    margin-top: 5px;
}

.menu-content {
    position: absolute;
    left: 5.6%;
    top: 15.3%;
    width: 34%;
    height: 73%;
}

.title-protocol {
    color: rgb(230, 242, 247);
    font-size: 72px;
    -unity-font-style: bold;
    letter-spacing: 12px;
    white-space: nowrap;
}

.title-line {
    width: 78%;
    height: 2px;
    margin-top: 4px;
    background-color: rgba(124, 208, 232, 0.65);
}

.title-zero {
    color: rgb(234, 245, 250);
    font-size: 126px;
    -unity-font-style: bold;
    letter-spacing: 17px;
    line-height: 1;
    white-space: nowrap;
    margin-top: -7px;
}

.tagline {
    color: rgb(183, 209, 221);
    font-size: 20px;
    letter-spacing: 4px;
    margin-top: 4px;
    margin-bottom: 26px;
    white-space: nowrap;
}

.menu-buttons {
    width: 83%;
    flex-direction: column;
}

.menu-button {
    height: 72px;
    min-height: 58px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    padding-left: 25px;
    padding-right: 20px;
    background-color: rgba(3, 18, 26, 0.76);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(128, 190, 211, 0.62);
    border-right-color: rgba(128, 190, 211, 0.62);
    border-bottom-color: rgba(128, 190, 211, 0.62);
    border-left-color: rgba(128, 190, 211, 0.62);
}

.menu-button:hover,
.menu-button:focus {
    background-color: rgba(0, 190, 220, 0.24);
    border-top-color: rgb(0, 224, 255);
    border-right-color: rgb(0, 224, 255);
    border-bottom-color: rgb(0, 224, 255);
    border-left-color: rgb(0, 224, 255);
}

.menu-button-primary {
    background-color: rgba(0, 117, 141, 0.48);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 4px;
    border-top-color: rgb(0, 223, 255);
    border-right-color: rgb(0, 223, 255);
    border-bottom-color: rgb(0, 223, 255);
    border-left-color: rgb(0, 223, 255);
}

.menu-button-primary:hover,
.menu-button-primary:focus {
    background-color: rgba(0, 190, 220, 0.38);
}

.button-icon {
    width: 48px;
    color: rgb(199, 226, 237);
    font-size: 26px;
    -unity-text-align: middle-center;
    margin-right: 24px;
}

.button-title {
    flex-grow: 1;
    color: rgb(221, 238, 246);
    font-size: 17px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.button-arrow {
    color: rgb(154, 199, 218);
    font-size: 25px;
    margin-left: 10px;
    -unity-text-align: middle-center;
}

.menu-button-primary .button-icon,
.menu-button-primary .button-title,
.menu-button-primary .button-arrow {
    color: rgb(239, 250, 255);
}

.bottom-footer {
    position: absolute;
    left: 2.8%;
    right: 2.8%;
    bottom: 5.5%;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.tiny-label {
    color: rgba(147, 174, 190, 0.82);
    font-size: 9px;
    letter-spacing: 2px;
    margin-top: 8px;
}

.system-status {
    flex-direction: row;
    align-items: center;
}

.system-status .micro-label {
    font-size: 10px;
    margin-right: 16px;
}

.ready-label {
    color: rgb(0, 232, 218);
    font-size: 16px;
    letter-spacing: 4px;
    -unity-font-style: bold;
}

.subpage-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 5, 9, 0.8);
}

.subpage-card {
    width: 58%;
    max-width: 1000px;
    min-width: 540px;
    max-height: 88%;
    padding: 34px 48px;
    background-color: rgba(8, 20, 30, 0.97);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 3px;
    border-top-color: rgba(87, 184, 214, 0.7);
    border-right-color: rgba(87, 184, 214, 0.7);
    border-bottom-color: rgba(87, 184, 214, 0.7);
    border-left-color: rgb(0, 217, 255);
}

.subpage-title {
    color: rgb(0, 218, 255);
    font-size: 27px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    margin-bottom: 22px;
}

.briefing-copy {
    color: rgb(214, 228, 236);
    font-size: 15px;
    white-space: normal;
    margin-bottom: 15px;
}

.back-button {
    height: 48px;
    color: rgb(228, 242, 249);
    background-color: rgba(0, 119, 145, 0.28);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(0, 217, 255);
    border-right-color: rgb(0, 217, 255);
    border-bottom-color: rgb(0, 217, 255);
    border-left-color: rgb(0, 217, 255);
    margin-top: 12px;
}

.option-slider,
.option-toggle,
.option-dropdown {
    color: rgb(226, 239, 245);
    margin-top: 12px;
    margin-bottom: 12px;
}

.option-slider .unity-base-field__label,
.option-toggle .unity-base-field__label,
.option-dropdown .unity-base-field__label {
    color: rgb(151, 190, 207);
    min-width: 190px;
    letter-spacing: 2px;
}
